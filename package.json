{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "brand:generate": "node --import tsx scripts/generate-brand-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "benchmark:openrouter": "tsx scripts/benchmark-openrouter.ts",
    "create:sponsor-addresses": "node --import tsx scripts/create-sponsor-addresses.ts",
    "verify:market-providers": "tsx scripts/verify-market-providers.ts",
    "verify:jupiter-build": "tsx scripts/verify-jupiter-build.ts",
    "worker": "tsx infrastructure/railway-worker.ts",
    "prepare:railway-function": "node scripts/prepare-railway-function.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@magic-ext/oauth2": "15.14.0",
    "@magic-ext/solana": "30.12.0",
    "@magic-sdk/admin": "2.8.2",
    "@radix-ui/react-dialog": "1.1.20",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "encoding": "0.1.13",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.47.0",
    "magic-sdk": "33.13.0",
    "motion": "13.4.4",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.32.0",
    "sonner": "2.0.8",
    "torph": "0.1.3",
    "tweetnacl": "1.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "stream-json": "3.7.0",
    "uuid": "11.1.1"
  }
}
