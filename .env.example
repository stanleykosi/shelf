# Copy to .env.local. Keep real values in local secret storage or the hosting provider.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Shelf

DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelf
MIGRATION_DATABASE_URL=postgres://shelf:shelf@localhost:5432/shelf
DATABASE_SSL=false

PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
XSTOCKS_API_BASE_URL=https://api.xstocks.fi/api/v2/

NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_SOLANA_RPC_URL=
MAGIC_SECRET_KEY=
MAGIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_TOKEN_HMAC_KEY=
OWNER_MAGIC_ISSUER=
SUPPORT_CONTACT=

OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=z-ai/glm-5.3-flash
OPENROUTER_TEXT_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER_POLICY=zdr-deny-required
AI_DAILY_LIMIT_USD=2
AI_MONTHLY_LIMIT_USD=20
ENABLE_AI_ALLOCATION_SUGGESTIONS=false

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=
SOLANA_GENESIS_HASH=
JUPITER_API_KEY=
SPONSOR_PUBLIC_KEY=
FEE_USDC_TOKEN_ACCOUNT=
